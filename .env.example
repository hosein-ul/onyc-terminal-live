# Copy to .env and fill in. Never commit .env.
# The platform runs without the optional keys; those features show "not configured".

# Postgres (matches docker-compose.yml; local development values only)
DATABASE_URL=postgres://onyc:onyc_dev_only@localhost:5432/onyc

# Optional: Helius RPC for balances, supply, holders and the MarketStats PDA
HELIUS_API_KEY=

# Optional: Redis cache
REDIS_URL=

# Optional: Telegram alerts bot
TELEGRAM_BOT_TOKEN=

# Public base URL of the API (used for OpenAPI servers and bot links)
API_PUBLIC_URL=http://localhost:4000

# Read by the five web apps at build time (Vite). Leave empty to use the same origin, or the dev proxy to :4000.
VITE_API_URL=

# pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
