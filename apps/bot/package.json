{
  "name": "@onyc/bot",
  "version": "0.0.0",
  "private": true,
  "description": "Telegram and webhook alert delivery, driven by the events the worker writes.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "dev": "pnpm build && pnpm start"
  },
  "dependencies": {
    "@onyc/db": "workspace:*",
    "@onyc/format": "workspace:*",
    "@onyc/sdk": "workspace:*",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@onyc/worker": "workspace:*",
    "postgres": "^3.4.9",
    "pino-pretty": "^13.2.0"
  }
}
