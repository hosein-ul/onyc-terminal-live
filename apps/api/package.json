{
  "name": "@onyc/api",
  "version": "0.0.0",
  "private": true,
  "description": "Hono REST /v1, SSE stream and OpenAPI document (Phase 2).",
  "type": "module",
  "main": "./dist/main.js",
  "exports": {
    ".": {
      "default": "./dist/main.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "dev": "pnpm build && pnpm start"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@onyc/db": "workspace:*",
    "@onyc/format": "workspace:*",
    "@onyc/metrics": "workspace:*",
    "@onyc/sdk": "workspace:*",
    "@onyc/sources": "workspace:*",
    "hono": "^4.13.13",
    "pino": "^10.4.0",
    "zod": "^4.6.7",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@onyc/worker": "workspace:*",
    "@seriousme/openapi-schema-validator": "^2.11.0",
    "vite": "^8.3.5"
  }
}
