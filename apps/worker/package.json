{
  "name": "@onyc/worker",
  "version": "0.0.0",
  "private": true,
  "description": "Ingestion scheduler, backfills and alert evaluator (Phase 1).",
  "type": "module",
  "main": "./dist/main.js",
  "exports": {
    ".": {
      "default": "./dist/main.js"
    },
    "./testing": {
      "types": "./dist/testing/seed.d.ts",
      "default": "./dist/testing/seed.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "dev": "pnpm build && pnpm start",
    "demo:diff": "pnpm build && node --env-file-if-exists=../../.env dist/demo/sheet-diff.js"
  },
  "dependencies": {
    "@onyc/db": "workspace:*",
    "@onyc/format": "workspace:*",
    "@onyc/sources": "workspace:*",
    "croner": "^10.0.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "pino-pretty": "^13.2.0"
  }
}
