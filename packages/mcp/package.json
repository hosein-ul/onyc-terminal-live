{
  "name": "@onyc/mcp",
  "version": "0.0.0",
  "private": true,
  "description": "Read-only MCP server over the /v1 API: one tool per read endpoint, over stdio.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "start": "node --env-file-if-exists=../../.env dist/main.js"
  },
  "bin": {
    "onyc-mcp": "./dist/main.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@onyc/sdk": "workspace:*",
    "zod": "^4.6.7"
  }
}
