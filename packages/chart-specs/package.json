{
  "name": "@onyc/chart-specs",
  "version": "0.0.0",
  "private": true,
  "description": "Library-agnostic chart specs: data, annotations, units, provenance, table and CSV (Phase 3).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dom": {
      "types": "./dist/dom.d.ts",
      "default": "./dist/dom.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@onyc/format": "workspace:*",
    "@onyc/sdk": "workspace:*"
  }
}
