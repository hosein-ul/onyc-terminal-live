{
  "name": "@onyc/format",
  "version": "0.0.0",
  "private": true,
  "description": "Number, currency, bps, date and age formatting in one place.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
