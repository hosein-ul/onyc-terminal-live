{
  "name": "@onyc/sources",
  "version": "0.0.0",
  "private": true,
  "description": "One client per upstream source with zod schemas and fixtures (Phase 1).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "test:live": "vitest run --config vitest.live.config.ts"
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}
