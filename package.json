{
  "name": "onyc-terminal",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Unofficial, community-built, read-only analytics terminal for OnRe's ONyc.",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:live": "turbo run test:live",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:local": "node scripts/local-db.mjs",
    "db:generate": "pnpm --filter @onyc/db generate",
    "db:migrate": "pnpm --filter @onyc/db migrate",
    "db:utf8": "pnpm --filter @onyc/db db:utf8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.0",
    "embedded-postgres": "16.14.0-beta.17",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
